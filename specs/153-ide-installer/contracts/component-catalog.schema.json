{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NetClaw component catalog 1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "revision": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      },
      "minItems": 1,
      "maxItems": 512
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill"
      },
      "minItems": 1,
      "maxItems": 2048
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      },
      "minItems": 1,
      "maxItems": 64
    },
    "memberProfiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/member"
      },
      "minItems": 0,
      "maxItems": 128
    },
    "surfaceAliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "surface": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "minItems": 0,
            "maxItems": 256,
            "uniqueItems": true
          },
          "role": {
            "enum": [
              "install",
              "management",
              "external"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1
          },
          "fieldKeys": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "maxItems": 256
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 4096
            },
            "maxItems": 64
          }
        },
        "required": [
          "surface",
          "components",
          "role",
          "reason",
          "fieldKeys",
          "files"
        ]
      },
      "minItems": 0,
      "maxItems": 512
    },
    "choices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/choice"
      },
      "maxItems": 256
    },
    "externalIntegrations": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "components",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 32
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    }
  },
  "required": [
    "schema",
    "revision",
    "components",
    "skills",
    "profiles",
    "memberProfiles",
    "surfaceAliases",
    "choices",
    "externalIntegrations"
