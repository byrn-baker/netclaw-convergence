[Unit]
Description=NetClaw authenticated durable IDS ingestion
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/netclaw/services/ids-ingest
Environment=IDS_CONFIG_FILE=/home/ubuntu/netclaw/deploy/convergence/secrets/ids/config.json
ExecStart=/home/ubuntu/netclaw/.venv/bin/python -m uvicorn server:configured_app --factory --host 0.0.0.0 --port 8445 --ssl-certfile /home/ubuntu/netclaw/deploy/convergence/secrets/ids/server.crt --ssl-keyfile /home/ubuntu/netclaw/deploy/convergence/secrets/ids/server.key --no-access-log
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/netclaw-ids-ingest
PrivateTmp=true

[Install]
WantedBy=multi-user.target
