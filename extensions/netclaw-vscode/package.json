{
  "name": "netclaw",
  "displayName": "NetClaw",
  "description": "Manage existing NetClaw and Risk installations from Visual Studio Code.",
  "version": "1.1.0",
  "publisher": "NetClaw",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.102.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "netclaw",
    "network",
    "openclaw",
    "hermes",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/automateyournetwork/netclaw.git",
    "directory": "extensions/netclaw-vscode"
  },
  "bugs": {
    "url": "https://github.com/automateyournetwork/netclaw/issues"
  },
  "homepage": "https://github.com/automateyournetwork/netclaw",
  "icon": "resources/icon.png",
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onView:netclaw.connections"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Help and saved profile labels are available. Connections and operational actions require workspace trust."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:editor": "node scripts/editor.mjs",
    "vscode:prepublish": "npm run check && npm run build",
    "package": "node scripts/package.mjs",
    "publisher:login": "vsce login NetClaw",
    "publisher:verify": "vsce verify-pat NetClaw",
    "preview:local": "npm run build && node scripts/preview.mjs",
    "preview:workspace": "node scripts/workspace-preview.mjs",
    "test:workspace": "node --test test/claw-*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.185.1",
    "yaml": "2.9.1",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/vscode": "1.102.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "netclaw",
          "title": "NetClaw",
          "icon": "resources/activity.svg"
        }
      ]
    },
    "views": {
      "netclaw": [
        {
          "id": "netclaw.connections",
          "name": "Connections"
        },
        {
          "id": "netclaw.estate",
          "name": "Risk & Federation"
        },
        {
          "id": "netclaw.operations",
          "name": "Operations"
        },
        {
          "id": "netclaw.integrations",
          "name": "Integrations"
        },
        {
          "id": "netclaw.knowledge",
          "name": "Knowledge"
        },
        {
          "id": "netclaw.security",
          "name": "Security"
        },
        {
          "id": "netclaw.help",
          "name": "Help"
        }
      ]
    },
    "commands": [
      {
