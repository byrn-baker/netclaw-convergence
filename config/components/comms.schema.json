{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NetClaw Comms catalog 1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "checkedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "revision",
    "checkedAt",
    "entries"
  ],
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9-]{0,127}$"
        },
        "inventory": {
          "enum": [
            "channel",
            "related",
            "netclaw"
          ]
        },
        "harness": {
          "enum": [
            "openclaw",
            "hermes"
          ]
        },
        "channelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "nativeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "kind": {
          "enum": [
            "agent-protocol",
            "browser-api-interface",
            "browser-interface",
            "connector-transport",
            "conversation-channel",
            "event-ingress",
            "event-tool-integration",
            "explicitly-requested-external-plugin",
            "meeting-ingress-and-context-tools",
            "meeting-workflow",
            "microsoft-365-event-ingress",
            "outbound-and-account-tools",
            "related-optional-telephony-skill",
            "related-telephony-plugin",
            "retired-path-reference",
            "voice-tools-and-separate-webhook-ingress"
          ]
        },
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "focused",
              "border",
              "member"
            ]
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "hosts": {
          "type": "array",
          "items": {
            "enum": [
              "macos",
              "wsl2"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "documentation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "checkedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "commit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^[a-f0-9]{40}$"
            },
            "support": {
              "enum": [
                "present",
                "not-found",
                "reference"
              ]
            },
            "evidence": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "required": [
            "version",
            "commit",
            "support",
            "evidence"
          ]
        },
        "component": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "setup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "disposition": {
              "enum": [
                "typed",
                "native",
                "incomplete-adapter",
                "unavailable-baseline",
                "incompatible-dependency",
                "reference-only"
              ]
            },
            "method": {
              "enum": [
                "typed",
                "native",
                "component",
                "none"
              ]
            },
            "adapter": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "settings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 1,
                    "pattern": "^[A-Z][A-Z0-9_]*$"
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 1
                  },
                  "help": {
                    "type": "string",
                    "maxLength": 2048,
                    "minLength": 1
                  },
                  "classification": {
                    "enum": [
                      "secret",
                      "private",
                      "public"
                    ]
                  },
                  "valueType": {
                    "enum": [
                      "string",
                      "integer",
                      "boolean",
                      "url",
                      "path"
                    ]
                  },
                  "required": {
                    "enum": [
                      "always",
                      "optional",
                      "conditional"
                    ]
                  },
                  "condition": {
                    "$ref": "#/$defs/condition"
                  },
                  "example": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "sharedWith": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 64,
                      "minLength": 1,
                      "pattern": "^[a-z][a-z0-9-]{0,63}$"
                    },
                    "minItems": 0,
                    "maxItems": 256,
                    "uniqueItems": true
                  },
                  "provenance": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "source": {
                          "type": "string",
                          "maxLength": 2048,
                          "minLength": 1
                        },
                        "checkedAt": {
                          "type": "string",
                          "maxLength": 10,
                          "minLength": 1,
                          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                        },
                        "note": {
                          "type": "string",
                          "maxLength": 2048,
                          "minLength": 1
                        }
                      },
                      "required": [
                        "source",
                        "checkedAt",
                        "note"
                      ]
                    },
                    "minItems": 1,
                    "maxItems": 32
                  },
                  "input": {
                    "enum": [
                      "user",
                      "generated"
                    ]
                  }
                },
                "required": [
                  "key",
                  "label",
                  "help",
                  "classification",
                  "valueType",
                  "required",
                  "condition",
                  "example",
                  "sharedWith",
                  "provenance",
                  "input"
                ]
              },
              "minItems": 0,
              "maxItems": 128
            },
            "access": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "minItems": 0,
              "maxItems": 128,
              "uniqueItems": true
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "integrity": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": [
                  "id",
                  "version",
                  "source",
                  "integrity"
                ]
              },
              "minItems": 0,
              "maxItems": 128,
              "uniqueItems": true
            },
            "startupEffects": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "minItems": 0,
              "maxItems": 128,
              "uniqueItems": true
            },
            "readback": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "disposition",
            "method",
            "adapter",
            "reason",
            "settings",
            "access",
            "dependencies",
            "startupEffects",
            "readback"
          ]
        },
        "qualification": {
          "enum": [
            "unverified",
            "locally-tested",
            "provider-tested"
          ]
        }
      },
      "required": [
        "id",
        "inventory",
        "harness",
        "channelId",
        "nativeId",
        "name",
        "aliases",
        "kind",
        "roles",
        "hosts",
        "documentation",
        "checkedAt",
        "baseline",
        "component",
        "setup",
        "qualification"
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "present": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "present"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "equals": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$",
                  "minLength": 1,
                  "maxLength": 128
                },
                "value": {
                  "oneOf": [
                    {
                      "type": "string",
                      "maxLength": 4096
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  ]
                }
              },
              "required": [
                "key",
                "value"
              ]
            }
          },
          "required": [
            "equals"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "minItems": 1,
              "maxItems": 32
            }
          },
          "required": [
            "all"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "minItems": 1,
              "maxItems": 32
            }
          },
          "required": [
            "any"
          ]
        }
      ]
    }
  }
}
