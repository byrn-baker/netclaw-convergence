# Add inside the existing `server { ... }` for zoom.automateyournetwork.ca,
# ABOVE `location / {`. Dot plugin URL becomes https://<host>/netclaw-dot/mcp
location /netclaw-dot/ {
    proxy_pass http://127.0.0.1:8765/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_buffering off;          # streamable HTTP / SSE
    proxy_read_timeout 300s;
    limit_except GET POST DELETE { deny all; }
}
location ~ ^/\.well-known/(oauth-protected-resource|oauth-authorization-server)/netclaw-dot {
    proxy_pass http://127.0.0.1:8765/.well-known/$1;
    proxy_set_header Host $host;
}
