IDS_SENSOR_ROOT=/opt/netclaw-ids-proxmox
IDS_CAPTURE_CONTAINER=netclaw-suricata-proxmox
# Resolve this from /sys/class/net/*/address after attaching the isolated NIC.
IDS_INTERFACE=eth1
IDS_INTERFACE_MAC=02:00:00:00:00:01
IDS_INGEST_URL=https://192.0.2.252:8445/v1/eve
IDS_CA_FILE=/opt/netclaw-ids-proxmox/ca.crt
IDS_TOKEN_FILE=/opt/netclaw-ids-proxmox/sensor-token
IDS_CAPTURE_CPUS=2
IDS_CAPTURE_MEMORY=3g
