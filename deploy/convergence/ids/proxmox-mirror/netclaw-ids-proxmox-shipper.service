[Unit]
Description=NetClaw durable Proxmox mirror EVE shipper
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
EnvironmentFile=/opt/netclaw-ids-proxmox/sensor.env
ExecStart=/usr/bin/python3 /opt/netclaw-ids-proxmox/shipper.py
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/netclaw-ids-proxmox
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
