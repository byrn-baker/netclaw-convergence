    {
      "id": 7,
      "title": "EVE observations by type",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics-longterm"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(netclaw_ids_events_ingested_total{site=~\"${site:regex}\"}[$__rate_interval])",
