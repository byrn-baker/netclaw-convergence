{
  "uid": "convergence-ids",
  "title": "IDS Capture and Alerts",
  "tags": [
    "convergence",
    "ids",
    "suricata"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "Mirrored packet rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics-longterm"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(netclaw_ids_capture_packets_total{site=~\"${site:regex}\"}[$__rate_interval])",
          "legendFormat": "{{sensor}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics-longterm"
          },
          "range": true
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Capture loss fraction",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics-longterm"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(netclaw_ids_capture_drops_total{site=~\"${site:regex}\"}[$__rate_interval]) / clamp_min(rate(netclaw_ids_capture_packets_total{site=~\"${site:regex}\"}[$__rate_interval]), 1)",
          "legendFormat": "{{sensor}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics-longterm"
          },
          "range": true
        }
      ],
      "description": "Missed mirrored copies at the sensor, not production traffic blocked by an IPS.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Decoder event rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics-longterm"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(netclaw_ids_decoder_events_total{site=~\"${site:regex}\"}[$__rate_interval])",
          "legendFormat": "{{sensor}} / {{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics-longterm"
          },
          "range": true
        }
      ],
      "description": "Decoder categories can overlap. These are header-parser events, not TLS decryption failures.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "IDS alerts by original priority",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics-longterm"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(netclaw_ids_alerts_ingested_total{site=~\"${site:regex}\"}[$__rate_interval])",
          "legendFormat": "{{sensor}} / priority {{priority}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics-longterm"
          },
          "range": true
        }
      ],
      "description": "Priority 1 is highest. Counts start when telemetry was installed; archive backfill is excluded.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Mirror source visibility",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics-longterm"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "netclaw_ids_source_active{site=~\"${site:regex}\"}",
          "legendFormat": "{{sensor}} / {{source}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics-longterm"
          },
          "range": true
        }
      ],
      "description": "1 = recent heartbeat, capture probe and matching source header; 0 = visibility unverified.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
