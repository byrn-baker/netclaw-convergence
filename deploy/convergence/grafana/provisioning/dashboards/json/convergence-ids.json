  ],
  "templating": {
    "list": [
      {
        "name": "site",
        "label": "Site",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics-longterm"
        },
        "query": "label_values(netclaw_ids_sensor_last_seen_timestamp_seconds, site)",
        "refresh": 1,
        "current": {
          "text": "home",
          "value": "home"
        },
        "includeAll": false,
        "multi": false
      }
    ]
  }
