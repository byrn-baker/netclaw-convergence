        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "Time since VLAN observation",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics-longterm"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - (netclaw_ids_vlan_last_seen_timestamp_seconds{site=~\"${site:regex}\"} > 0)",
          "legendFormat": "{{sensor}} / VLAN {{vlan}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics-longterm"
          },
          "range": true
        }
      ],
      "description": "A quiet VLAN does not prove capture failure. Never-observed VLANs have no series here.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "spanNulls": false
          }
