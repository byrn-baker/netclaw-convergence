      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Time since capture statistics",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics-longterm"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - netclaw_ids_stats_timestamp_seconds{site=~\"${site:regex}\"}",
          "legendFormat": "{{sensor}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics-longterm"
          },
          "range": true
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
